# Rust build artifacts
target/
# Cargo.lock IS tracked — GGUF Chatbox is an application (binary), so the lockfile
# is committed for reproducible builds. Do not re-ignore it (a clean clone floated
# `time` to 0.3.52 which broke `cookie 0.18.1`; the pinned lock prevents that).

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# GGUF model files (large — store externally)
*.gguf
*.GGUF
*.bin
*.safetensors

# Environment and secrets
.env
.env.*
*.key
*.pem
*.p12

# IDE / OS
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# App data (generated at runtime — not source)
*.gguf-chatbox/
*.part

# Tauri build outputs
src-tauri/target/
src-tauri/WixTools/

# Node (if frontend ever gets a build step)
node_modules/
